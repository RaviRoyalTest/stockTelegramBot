[TEMPLATE]
# Telegram bot credentials (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
# Chat ID (use @userinfobot to find yours, or your group's id)
TELEGRAM_CHAT_ID=123456789
# Bot username (without @) - used for the blue one-tap command buttons
# (t.me/<username>?text=/cmd ...) that pre-fill a command into the input.
BOT_USERNAME=StockVigilBot

# ---------------------------------------------------------------------------
# Required on always-on hosts (Render, Railway, Fly.io, etc.) whose disk is
# EPHEMERAL. Without these, /add and /remove changes are saved only on the
# host's disk and are wiped on every redeploy.
#
# GH_TOKEN: a fine-grained Personal Access Token with "Contents: Read and
#           write" on this repository. Create one at:
#           https://github.com/settings/personal-access-tokens/new
#           (Repository access -> select this repo -> Permissions -> Contents
#           -> Read and write)
# GITHUB_REPOSITORY: "owner/repo" e.g. RaviRoyalTest/stockTelegramBot
# ---------------------------------------------------------------------------
# GH_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# GITHUB_REPOSITORY=RaviRoyalTest/stockTelegramBot
# GH_PUSH_BRANCH=main

# How often to poll for new corporate actions (seconds, min ~300)
POLL_INTERVAL_SECONDS=3600

# Outgoing email for /setemail + /email + /emailreport + /dailyemail
# (web composer at /email uses the same sender).
# EASIEST: set only RESEND_API_KEY (resend.com free, API Keys -> re_... key)
# and skip SMTP entirely - works even where SMTP ports are blocked.
# GMAIL (2 min, once):
#   1. Google Account > Security > turn ON 2-Step Verification.
#   2. Search "App passwords" > create one for Mail > copy the 16-letter code.
#   3. Paste the code below as SMTP_PASS (spaces are stripped automatically).
#   The login password will NOT work - it must be the App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Royal Stock <you@gmail.com>

# Alternative when SMTP ports are blocked on the host: Resend HTTPS API.
# Free tier at resend.com (API Keys -> copy the re_... key). No app password.
# Takes precedence over the SMTP settings above when set.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Royal Stock <onboarding@resend.dev>

# Optional mail polish (used by Telegram + web + daily digest):
# EMAIL_SUBJECT_PREFIX=My Stocks
# EMAIL_FROM_NAME=Royal Stock

# Number of past days of announcements to fetch (used for BSE range)
LOOKBACK_DAYS=30

# Default market-hours gate for scheduled reports (always-on server):
#   in  = India (NSE/BSE 09:15-15:30 IST) - default
#   us  = US (NASDAQ/NYSE 09:30-16:00 ET)
#   any = no gate - run any time the timer fires
# Per-entry overrides can be set from Telegram (/schedule add 3h /cmd us) and
# a per-user default with /market.
SCHEDULED_REPORTS_MARKET=in
